# 1. Виртуальное окружение
# Исключает вашу локальную среду Python
venv/
.venv/

# 2. Папки, созданные Python/Django
# Исключает кэш и байт-код
__pycache__/
*.pyc

# 3. Системные и временные файлы
# Исключает файлы операционной системы и редакторов
.DS_Store
*.tmp
temp/
tmp/

# 4. Система контроля версий
# Исключает метаданные Git (самое важное!)
.git/
.gitignore

# 5. Секреты и локальные конфигурации
# Исключает локальные настройки и файлы, 
# которые должны быть предоставлены через Docker secrets/ENV
# (замените на свои названия, если у вас есть такие файлы)
.env
*.key
*.pem
local_settings.py 

# 6. Логи
# Исключает файлы логов
*.log
logs/

# 7. Папки, которые могут быть большими (если они не нужны для сборки)
# Исключает сгенерированные фронтенд-ресурсы, если они не собираются в Docker
node_modules/